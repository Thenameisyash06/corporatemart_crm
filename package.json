{
  "name": "corporatemart_crm",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "server": "node --watch src/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "postinstall": "prisma generate && npm --prefix client install",
    "desktop": "electron electron/main.js",
    "desktop:dev": "concurrently -k \"node --watch src/server.js\" \"npm --prefix client run dev\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "desktop:build": "npm run build && electron-builder",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "dev": "concurrently -k \"node --watch src/server.js\" \"npm --prefix client run dev\"",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "prisma": "^5.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.corporatemart.crm",
    "productName": "CorporateMart CRM",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CorporateMart CRM",
      "uninstallDisplayName": "CorporateMart CRM",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
